#!/usr/bin/env bash
set -euo pipefail

EXPECTED_HEAD="df45fb9f15d6fd79490622a0fbea9ea42243dccf"
EXPECTED_COUNT=993
LFS_FILE="02_Evidencias/00_Restringido/evidencias_restringidas.7z"

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ERROR: Ejecuta este script dentro del repositorio FabroGym_ISR401."
  exit 1
}
cd "$ROOT"

ACTUAL_HEAD="$(git rev-parse HEAD)"
if [[ "$ACTUAL_HEAD" != "$EXPECTED_HEAD" ]]; then
  echo "ERROR: HEAD no coincide con el corte verificado."
  echo "Esperado: $EXPECTED_HEAD"
  echo "Actual:   $ACTUAL_HEAD"
  echo "No generes el manifiesto hasta sincronizar main."
  exit 1
fi

# El repositorio debe estar limpio ANTES de regenerar el manifiesto.
DIRTY="$(git status --porcelain --untracked-files=all)"
if [[ -n "$DIRTY" ]]; then
  echo "ERROR: Hay cambios locales antes de generar el checksum:"
  echo "$DIRTY"
  exit 1
fi

# El cierre anterior verificó el objeto Git LFS materializado, no el puntero.
if [[ ! -f "$LFS_FILE" ]]; then
  echo "ERROR: No existe $LFS_FILE"
  exit 1
fi

LFS_SIZE="$(wc -c < "$LFS_FILE" | tr -d '[:space:]')"
if [[ "$LFS_SIZE" -lt 1000000000 ]]; then
  echo "ERROR: El archivo LFS parece ser solo un puntero ($LFS_SIZE bytes)."
  echo "Ejecuta primero:"
  echo "  git lfs pull --include=\"$LFS_FILE\""
  echo "y vuelve a ejecutar este script."
  exit 1
fi

echo "Generando checksums.sha256 sobre main $ACTUAL_HEAD ..."
rm -f checksums.sha256

find . \
  -path './.git' -prune -o \
  -path './checksums.sha256' -prune -o \
  -type f -print0 \
  | sort -z \
  | xargs -0 sha256sum > checksums.sha256

COUNT="$(wc -l < checksums.sha256 | tr -d '[:space:]')"
if [[ "$COUNT" -ne "$EXPECTED_COUNT" ]]; then
  echo "ERROR: Se esperaban $EXPECTED_COUNT entradas y se generaron $COUNT."
  echo "No hagas commit ni tag. Revisa el árbol del repositorio."
  exit 1
fi

echo "Verificando las $COUNT entradas ..."
sha256sum -c checksums.sha256 --quiet

echo
echo "OK: checksums.sha256 definitivo generado y verificado."
echo "Entradas: $COUNT"
echo "SHA-256 del propio manifiesto:"
sha256sum checksums.sha256
echo
echo "Ahora GitHub Desktop debe mostrar UN cambio: checksums.sha256"
